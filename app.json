{
  "expo": {
    "name": "QMSoft School",
    "slug": "qmschool",
    "scheme": "qmschool",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#6D3CF0",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qmsofts.school"
    },
    "android": {
      "package": "com.qmsofts.school",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6D3CF0"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#6D3CF0"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "extra": {
      "apiBase": "https://schoolnet-production-fedc.up.railway.app",
      "eas": {
        "projectId": "64bbf8cb-25b7-4727-b1bb-fb09e08e2b95"
      }
    },
    "owner": "schooldotnet",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "notification": {
      "iosDisplayInForeground": true
    }
  }
}
